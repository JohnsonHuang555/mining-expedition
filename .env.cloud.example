# 單人開發的 Cloud 部署設定（docs/DEPLOYMENT.md）。
# 複製成 .env.cloud 後填寫：cp .env.cloud.example .env.cloud
# .env.cloud 已被 .gitignore 排除。這裡只放「不是密鑰」的設定：
#   - 不要放 Supabase access token、資料庫密碼 / 連線字串、service_role / secret key。
#   - 資料庫連線字串（pnpm cloud verify / report 用）只用環境變數 CLOUD_DB_URL 臨時提供。

# 目標 Supabase 專案的 Project ref（Dashboard → Project Settings → General；20 個小寫英文字母）
CLOUD_PROJECT_REF=

# 永遠不可部署的 project ref（例如未來的正式環境），逗號分隔；可留空
CLOUD_BLOCKED_REFS=

# Vercel 的網址（Production Domain，例如 https://mining-expedition.vercel.app）
# Edge Functions 的 CORS 只允許這個 origin（pnpm cloud secrets 會設定 GAME_API_ALLOWED_ORIGIN）
CLOUD_WEB_URL=

# 其他允許的 origin（例如自訂網域），完整的 https origin、逗號分隔、不可用 *；可留空
CLOUD_EXTRA_ORIGINS=

# Supabase publishable / anon key（公開的，與 Vercel 的 NEXT_PUBLIC_SUPABASE_ANON_KEY 相同；smoke test 用）
CLOUD_SUPABASE_ANON_KEY=

# 選填：Edge Function 的限流與逾時（不填 = 程式預設值）
# GAME_RATE_LIMIT_ACTION=30/10000
# GAME_RATE_LIMIT_STATE=20/10000
# GAME_RATE_LIMIT_CREATE=5/60000
# GAME_DB_TIMEOUT_MS=8000

# 選填：smoke test 帳號（不填 = 只跑不需要登入的檢查）。
# 建議不要寫在檔案裡，改成在終端機臨時 export SMOKE_USER_EMAIL / SMOKE_USER_PASSWORD。
# SMOKE_USER_EMAIL=
# SMOKE_USER_PASSWORD=
# 第二個帳號（選填）：額外檢查跨玩家隔離
# SMOKE_USER_B_EMAIL=
# SMOKE_USER_B_PASSWORD=

# 選填：資料庫 CA 憑證路徑（Dashboard → Database Settings → SSL 下載），pnpm cloud verify / report 用來驗證伺服器憑證
# CLOUD_DB_CA_FILE=
